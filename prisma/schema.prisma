generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  name                 String?
  role                 String       @default("founder")
  passwordHash         String?
  emailVerified        Boolean      @default(false)
  verificationToken    String?
  verificationExpires  DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  mustChangePassword   Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  startups             Startup[]
  memberships          Membership[]
  sentInvites          Invitation[] @relation("InvitationInvitedBy")
  conversations        Conversation[]
}

model Startup {
  id            String            @id @default(uuid())
  name          String
  industry      String
  description   String
  fundingStage  String            @default("pre-seed")
  cashBalance   Float             @default(250000)
  burnRate      Float             @default(15000)
  healthScore   Int               @default(78)
  ownerId       String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  commands      Command[]
  decisions     DecisionLog[]
  agents        ExecutiveAgent[]
  healthScores  HealthScore[]
  memories      Memory[]
  notifications Notification[]
  plans         Plan[]
  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documents     StartupDocument[]
  timeline      TimelineItem[]
  memberships   Membership[]
  invitations   Invitation[]
  conversations Conversation[]
}

/// P1 Task 8 — authoritative relationship between a User and a Startup/Company.
/// `Startup.ownerId` is retained for backwards compatibility; the founder also
/// receives an explicit FOUNDER Membership so all access can resolve uniformly
/// through: User -> Membership -> Startup -> role -> permissionService.
model Membership {
  id        String   @id @default(uuid())
  userId    String
  startupId String
  /// One of permissionService.ROLES (FOUNDER | ADMIN | FINANCE | HR | OPERATIONS | GROWTH).
  role      String   @default("OPERATIONS")
  /// ACTIVE | SUSPENDED. Invited-but-not-yet-accepted state lives on Invitation,
  /// so a Membership row always means "this user really has access".
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, startupId])
  @@index([startupId])
  @@index([userId])
}

/// P1 Task 8 — a pending offer of Membership for an email address.
/// Only the SHA-256 hash of the token is stored; the raw token is handed to the
/// invitee once, via the invitation URL, and never persisted or returned again.
model Invitation {
  id          String    @id @default(uuid())
  startupId   String
  email       String
  /// One of permissionService.ROLES, validated server-side before persisting.
  role        String
  /// SHA-256 hex digest of the raw invitation token. Never exposed through any API.
  tokenHash   String    @unique
  /// PENDING | ACCEPTED | EXPIRED | REVOKED
  status      String    @default("PENDING")
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startup     Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([startupId, status])
  @@index([email])
}

model StartupDocument {
  id                  String           @id @default(uuid())
  name                String
  type                String           @default("general")
  sourceType          String           @default("DOCUMENT")
  sourceRecordId      String?
  version             Int              @default(1)
  accessScope         String           @default("ALL")
  size                String           @default("0 KB")
  summary             String           @default("")
  insights            String[]         @default([])
  startupId           String
  indexingStatus      String           @default("COMPLETED")
  errorMessage        String?
  embeddingModel      String           @default("gemini-embedding-2-preview")
  embeddingDimensions Int              @default(768)
  chunkingStrategy    String           @default("fixed_tokens_500_overlap_50")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  chunks              KnowledgeChunk[]
  startup             Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId, sourceType])
  @@index([startupId, accessScope])
  @@index([startupId, indexingStatus])
  @@index([sourceRecordId])
}

model KnowledgeChunk {
  id               String          @id @default(uuid())
  chunkIndex       Int             @default(0)
  content          String
  documentId       String
  startupId        String          @default("default_startup")
  sourceType       String          @default("DOCUMENT")
  sourceRecordId   String?
  accessScope      String          @default("ALL")
  tokenCount       Int?
  embeddingModel   String          @default("gemini-embedding-2-preview")
  chunkingStrategy String          @default("fixed_tokens_500_overlap_50")
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  embedding        Embedding?
  document         StartupDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
  @@index([startupId, accessScope])
  @@index([startupId, sourceRecordId])
  @@index([startupId, sourceType])
  @@index([startupId, isActive])
  @@index([embeddingModel])
}

model KnowledgeJob {
  id               String    @id @default(uuid())
  startupId        String
  sourceType       String    @default("DOCUMENT")
  sourceRecordId   String
  action           String    @default("UPSERT")
  status           String    @default("PENDING")
  payload          Json?
  idempotencyKey   String    @unique
  attempts         Int       @default(0)
  maxAttempts      Int       @default(3)
  lastError        String?
  embeddingModel   String    @default("gemini-embedding-2-preview")
  chunkingStrategy String    @default("fixed_tokens_500_overlap_50")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  processedAt      DateTime?

  @@index([startupId, status])
  @@index([status, createdAt])
  @@index([sourceType, sourceRecordId])
}

model Embedding {
  id        String         @id @default(uuid())
  vector    Float[]
  chunkId   String         @unique
  createdAt DateTime       @default(now())
  chunk     KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId])
}

model ExecutiveAgent {
  id          String   @id @default(uuid())
  role        String
  name        String
  avatar      String
  status      String   @default("idle")
  currentTask String?
  startupId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  startup     Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model Command {
  id        String   @id @default(uuid())
  content   String
  status    String   @default("pending")
  startupId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model Plan {
  id          String      @id @default(uuid())
  title       String
  description String
  status      String      @default("planning")
  startupId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  approvals   Approval[]
  executions  Execution[]
  startup     Startup     @relation(fields: [startupId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id         String   @id @default(uuid())
  title      String
  assignedTo String
  status     String   @default("pending")
  result     String?
  planId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Approval {
  id              String   @id @default(uuid())
  title           String
  description     String
  type            String
  status          String   @default("pending_review")
  content         String
  impact          String
  financialChange Float    @default(0)
  metricChanges   Json
  planId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  startupId String
  createdAt DateTime @default(now())
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model HealthScore {
  id        String   @id @default(uuid())
  score     Int
  metrics   Json
  startupId String
  createdAt DateTime @default(now())
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model TimelineItem {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("milestone")
  startupId String
  createdAt DateTime @default(now())
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model DecisionLog {
  id              String   @id @default(uuid())
  title           String
  description     String
  category        String
  impactText      String
  financialImpact Float    @default(0)
  status          String   @default("approved")
  startupId       String
  createdAt       DateTime @default(now())
  startup         Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model Memory {
  id          String   @id @default(uuid())
  category    String
  title       String
  description String
  startupId   String
  createdAt   DateTime @default(now())
  startup     Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model Execution {
  id        String   @id @default(uuid())
  action    String
  payload   Json
  status    String   @default("completed")
  planId    String
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model approval_gates {
  id          String  @id @db.VarChar
  action_type String  @db.VarChar
  payload     Json    @db.Json
  status      String? @db.VarChar
}

model candidates {
  id              String  @id @db.VarChar
  name            String  @db.VarChar
  email           String  @db.VarChar
  resume_text     String?
  match_score     Float?
  analysis_report String?
}

model startup_contexts {
  id                   String  @id @db.VarChar
  company_name         String  @db.VarChar
  industry             String  @db.VarChar
  target_icp           String?
  current_monthly_burn Float?
  cash_on_hand         Float?
}

model AgentRule {
  id          String   @id @default(uuid())
  startupId   String
  agentRole   String   // CEO, CFO, HR, CMO, COO, LEGAL, AUDITOR
  rules       String[] // Customizable behavioral constraints
  spendLimit  Float    @default(0)
  updatedAt   DateTime @updatedAt

  @@index([startupId, agentRole])
}

model OrchestrationRun {
  id           String   @id @default(uuid())
  startupId    String
  directive    String
  intent       String
  status       String   // pending, running, needs_approval, completed, failed
  dagPlan      Json     // Array of ordered steps and dependency graph
  results      Json     // Summary, evidence, calculations
  createdAt    DateTime @default(now())

  @@index([startupId, status])
}

model ActivityLog {
  id        String   @id @default(uuid())
  startupId String
  userId    String
  action    String   // TASK_CLAIMED, TASK_SUBMITTED, RULE_MODIFIED, APPROVAL_GRANTED
  details   Json
  timestamp DateTime @default(now())

  @@index([startupId, userId])
  @@index([startupId, action])
}

model Conversation {
  id         String                @id @default(uuid())
  title      String                @default("New Conversation")
  userId     String
  startupId  String
  isArchived Boolean               @default(false)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @default(now()) @updatedAt
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  startup    Startup               @relation(fields: [startupId], references: [id], onDelete: Cascade)
  messages   ConversationMessage[]

  @@index([userId, startupId])
  @@index([startupId])
}

model ConversationMessage {
  id                String       @id @default(uuid())
  conversationId    String
  role              String
  content           String
  citations         Json?
  metadata          Json?
  isDecision        Boolean      @default(false)
  isSharedKnowledge Boolean      @default(false)
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([isSharedKnowledge])
  @@index([isDecision])
}

