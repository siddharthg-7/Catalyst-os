# CatalystOS Frontend Environment Variables
# Copy to frontend/.env for local standalone development

# Base URL for backend Express API (leave empty to use relative /api proxy via Vite)
VITE_API_BASE_URL=

# FastApi Python Microservice (optional direct connection, proxy handled by default)
VITE_FASTAPI_URL=http://localhost:8000

# EmailJS Client Integration (optional for welcome emails)
VITE_EMAILJS_SERVICE_ID=service_6dwbxni
VITE_EMAILJS_TEMPLATE_ID=template_xqoitun
VITE_EMAILJS_PUBLIC_KEY=nO2rT6gqM7V9ZkWyJ
