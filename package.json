{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "test": "tsx --test --test-concurrency=1 tests/multiLevelOrchestration.test.ts tests/authSecurity.test.ts tests/financialEngine.test.ts tests/multiAgentCouncil.test.ts tests/productionVerification.test.ts tests/approvalContext.test.ts tests/companyContext.test.ts tests/membershipInvitations.test.ts tests/membershipRemoval.test.ts tests/accountAccessControl.test.ts tests/taskDelegation.test.ts tests/round2Hardening.test.ts tests/founderCommandPipeline.test.ts tests/companyKnowledgeRag.test.ts tests/taskDecompositionA4.test.ts tests/employeeWorkspaceB1B2.test.ts tests/missingAiCapabilityA6.test.ts tests/executiveCouncilPhaseB.test.ts tests/agentRulesAndActivityAudit.test.ts tests/smtpMailer.test.ts tests/multiAgentOrchestrator5Steps.test.ts",
    "build": "npm run build --prefix frontend && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && npm run lint --prefix frontend && npm run lint --prefix backend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@emailjs/browser": "^5.0.2",
    "@google/genai": "^2.4.0",
    "@gsap/react": "^2.1.2",
    "@lottiefiles/dotlottie-react": "^0.19.7",
    "@prisma/client": "^6.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.16",
    "officeparser": "^7.2.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "reactflow": "^11.11.4",
    "recharts": "^3.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@prisma/config": "^7.8.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
