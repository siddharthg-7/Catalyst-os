# =================================================================
# CatalystOS - Environment Configuration Blueprint (.env.example)
# Copy this file to .env and supply your credentials before deploying.
# =================================================================

# -----------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------
PORT=3000
NODE_ENV="production"
APP_URL="https://your-domain.com"
FASTAPI_URL="http://127.0.0.1:8000"

# -----------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------
# CRITICAL FOR PRODUCTION: Generate a 256-bit random secret:
# In Bash/Zsh/PowerShell run: openssl rand -hex 32
JWT_SECRET="generate_a_cryptographically_secure_random_key_here"
STRICT_SECURITY="false"

# -----------------------------------------------------------------
# AI Providers (Google Gemini & Deepgram Speech)
# -----------------------------------------------------------------
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
CLAUDE_CODE_KEY="your_claude_code_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
DEEPGRAM_API_KEY="your_deepgram_api_key_here"
RAG_DEBUG="false"

# -----------------------------------------------------------------
# PostgreSQL Database (Neon or Self-Hosted pgvector)
# -----------------------------------------------------------------
# Pooled connection string for high-concurrency application runtime:
DATABASE_URL="postgresql://neondb_owner:password@ep-late-mud-b42a9cnw-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30&pool_timeout=30"

# Direct unpooled connection string for Prisma schema migrations:
DIRECT_URL="postgresql://neondb_owner:password@ep-late-mud-b42a9cnw.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30"

# -----------------------------------------------------------------
# Neon Auth / Managed Better Auth (Optional)
# -----------------------------------------------------------------
NEON_AUTH_BASE_URL="https://ep-late-mud-b42a9cnw.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-late-mud-b42a9cnw.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# -----------------------------------------------------------------
# S3-Compatible Object Storage (Neon Object Storage / AWS S3)
# -----------------------------------------------------------------
AWS_ENDPOINT_URL_S3="https://br-still-butterfly-b4tiugtf.storage.c-6.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="your_storage_access_key"
AWS_SECRET_ACCESS_KEY="your_storage_secret_key"
AWS_REGION="us-east-2"
AWS_S3_BUCKET="catalyst-documents"

# -----------------------------------------------------------------
# HashiCorp Vault (Optional Secret Management)
# -----------------------------------------------------------------
VAULT_ENABLED="false"
VAULT_ADDR="http://localhost:8200"
VAULT_TOKEN="root"
