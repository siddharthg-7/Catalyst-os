# CatalystOS Backend Environment Configuration
# Copy to backend/.env (or project root .env)

NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection (Neon / Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/catalyst_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/catalyst_db?schema=public"

# Authentication Security
JWT_SECRET="your_secure_jwt_secret_key_minimum_32_chars"

# Google Gemini API Key for Executive AI Reasoning
GEMINI_API_KEY="your_gemini_api_key_here"

# Claude Code & Anthropic API Key
CLAUDE_CODE_KEY="your_claude_code_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Deepgram Speech-to-Text & Text-to-Speech API
DEEPGRAM_API_KEY="your_deepgram_api_key_here"

# Python FastAPI AI Microservice URL (optional, defaults to http://127.0.0.1:8000)
FASTAPI_URL="http://127.0.0.1:8000"

# Optional Cloud Storage (AWS S3)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
S3_BUCKET_NAME="catalyst-knowledge-vault"

# Optional SMTP Email Dispatcher (Gmail / SES / Mailgun)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@yourdomain.com"
SMTP_PASS="your_app_specific_password"
SMTP_FROM="CatalystOS <notifications@yourdomain.com>"
